library(SparkR, lib.loc = c(file.path(Sys.getenv("SPARK_HOME"), "R", "lib")))
library(stringr)
comments_df <- read.df(
  source = "your source name",
  uri = "your connection string ",
  database = "your cluster name",
  collection = "your collection name"
)
data <- collect(comments_df)
comments_clean <- data$comment
comments_clean <- comments_clean[!is.na(comments_clean) & comments_clean != ""]
comments_clean <- tolower(comments_clean)
cat("Total comments:", length(comments_clean), "\n")
aspect_keywords <- list(
  Visual_Quality = c("realistic", "blurry", "sharp", "detail", "resolution", "texture", "lighting", "cinematic", "photorealistic", "pixelated", "grainy",
  "crystal clear", "vibrant", "high quality", "low quality", "4k", "8k", "hd", "looks real", "looks fake"),
  Motion_Fluidity = c("smooth", "choppy", "jittery", "laggy", "fluid", "natural movement", "robotic", "stiff", "framerate", "fps", "animation", "seamless",
  "glitchy", "stuttering", "buttery smooth", "motion"),
  Human_Features = c("hands", "fingers", "face", "eyes", "skin", "expression", "anatomy", "uncanny valley", "deformed", "weird face", "extra fingers",
  "missing fingers", "dead eyes", "distorted"),
  Creativity = c("masterpiece", "cinema", "art", "creative", "imagination", "prompt", "generation", "coherent", "incoherent", "nonsensical", "random", "messy", "story",
  "narrative", "emotional", "vibe", "aesthetic", "atmospheric", "surreal"),
  Speed_Efficiency = c("fast", "quick", "instant", "rapid", "slow", "lag", "render time", "generation time", "minutes", "seconds", "wait",
  "waiting", "efficient", "processing")
)
negative_medium <- c("bad", "poor", "disappointing", "mediocre", "subpar", "flawed", "problematic", "overrated", "not worth it", "blurry",
                      "pixelated", "choppy", "jittery", "low resolution", "uncanny", "weird", "creepy", "distorted", "glitchy", "robotic", "fake looking",
                      "inconsistent", "extra fingers", "dead eyes")
negation_words <- c("not", "n't", "never", "no", "none", "nothing", "without", "lack", "doesn't", "don't", "didn't", "won't", "can't",
                     "cannot", "isn't", "aren't")
has_negation <- function(text, word) {
  pattern <- paste0("(?:", paste(negation_words, collapse = "|"), ")\\s+(?:\\w+\\s+){0,2}", word)
  str_detect(text, pattern)
}
calc_aspect <- function(comment, words) {
  score <- 0
  for (w in words) {
  if (str_detect(comment, w)) {
  if (has_negation(comment, w)) {
    score <- score - 1}
  else {
near_negative <- any(sapply(negative_medium, function(n) str_detect(comment, n)))
  if (near_negative) {
  score <- score - 0.5}
  else {
  score <- score + 1
  }}}}
  return(score)
}
aspect_results <- list()
for (asp in names(aspect_keywords)) {
  aspect_results[[asp]] <- sapply(comments_clean, function(c) calc_aspect(c, aspect_keywords[[asp]]))
}
aspect_names <- c("Visual Quality", "Motion
Fluidity", "Human Features", "Creativity", "Speed")
pos_pcts <- c()
for (asp in names(aspect_results)) {
  scores <- aspect_results[[asp]]
  mentioned <- scores != 0
  mentioned_cnt <- sum(mentioned)
  if (mentioned_cnt > 0) {
    pos_cnt <- sum(scores[mentioned] > 0)
    pos_pct <- round(pos_cnt / mentioned_cnt * 100, 1)
  } else {
    pos_pct <- 0
  }
  pos_pcts <- c(pos_pcts, pos_pct)
}
cat("\nPositive percentages:\n")
for (i in seq_along(aspect_names)) {
  cat(aspect_names[i], ": ", pos_pcts[i], "%\n", sep = "")
}
scores_10 <- pos_pcts / 10
radar_data <- data.frame(
  Visual = scores_10[1],
  Motion = scores_10[2],
  Human = scores_10[3],
  Creativity = scores_10[4],
  Speed = scores_10[5]
)
radar_data <- rbind(
  rep(10, ncol(radar_data)), #for setting limit of largest number
  rep(0, ncol(radar_data)), #for setting limit of smallest number
  radar_data
)
colnames(radar_data) <- aspect_names
fill_color <- alpha("lightblue", 0.3)
line_color <- "lightblue"
op <- par(mar = c(3, 5, 3, 3))
radarchart(radar_data,
           axistype = 0,
           pcol = line_color,
           pfcol = fill_color,
           plwd = 3,
           cglcol = "grey60",
           cglty = 1,
           cglwd = 0.8,
           vlcex = 1.2,
           seg = 5
)
title("your title", cex.main = 1.6)
par(op)
